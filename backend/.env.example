# Runtime configuration for local development.
# Copy to backend/.env (gitignored) and fill in the Cloudinary values.

SOCKET_PORT=7000
METRICS_PORT=9464
FRONTEND_URL=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/pokemon-game
JWT_SECRET=change-me-in-production

# The game loads its card, cover and sound assets from Cloudinary at startup.
# The account must contain assets with the prefixes card_pokemon, cover_pokemon
# and audio_effect_*.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
